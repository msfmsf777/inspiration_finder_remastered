{
  "name": "inspiration-finder-remastered",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest run",
    "build": "npm -w @ifrm/core run build && npm -w @ifrm/cli run build && npm -w web run build",
    "e2e": "npm -w web run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
